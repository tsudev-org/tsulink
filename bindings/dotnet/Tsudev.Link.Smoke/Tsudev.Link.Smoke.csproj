<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kiểm thử trọn đường qua thư viện native thật (CI: job .NET). Console thuần - không cần gói NuGet test. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
